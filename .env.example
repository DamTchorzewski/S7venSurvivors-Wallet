# Copy to .env.local (git-ignored) and fill in. Standard: reops/standards/env.md
# Names only: no value is ever written here. Defaults live in the code.
# None of these is a secret: they are the public settings of the Firebase web app and the address of the API; Vite
# bakes them into the build.

# --- Firebase (sign-in with e-mail and password, and with Google) ------------------------------------------
# From the Firebase console: Project settings, General, Your apps, the web app, "firebaseConfig".
# GitHub: repository variables. Required for sign-in; empty = the sign-in buttons answer "not configured" (the demo works).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- API --------------------------------------------------------------------------------------------------

# Address of the API with /api at the end (the Cloud Run URL of personal-finance-manager-api).
# GitHub: repository variable. Optional. Empty = http://localhost:8080/api (the API run locally).
VITE_API_URL=
